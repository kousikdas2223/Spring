package com.in28minutes.spring.aop.AOPDemo;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.CommandLineRunner;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;

import com.in28minutes.spring.aop.AOPDemo.business.DepositBusinessService;
import com.in28minutes.spring.aop.AOPDemo.business.NewContractBusinessService;

@SpringBootApplication
public class AopDemoApplication implements CommandLineRunner {

	Logger logger = LoggerFactory.getLogger(this.getClass());
	
	@Autowired
	NewContractBusinessService newContractBusinessService;
	
	@Autowired
	DepositBusinessService depositBusinessService;

	public static void main(String[] args) {
		SpringApplication.run(AopDemoApplication.class, args);
	}

	@Override
	public void run(String... args) throws Exception {
		logger.info(newContractBusinessService.createNewContract());
		logger.info(depositBusinessService.submitDeposit());
		
	}

}
